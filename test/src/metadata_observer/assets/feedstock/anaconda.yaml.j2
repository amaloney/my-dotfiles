{#- Jinja2 template — schema: anaconda.schema.yaml (validate render context against it)
    Rendered values:
    pkg_name: PyPI/conda package name (always rendered as pypi upstream)
    github_repo: optional "owner/repo"
    gitlab_repo: optional "owner/repository"
    git_url: optional git clone URL; git_strip_prefix/git_tag_filter optional modifiers
    webpage_url + webpage_regex: optional fallback scraper pair
    Priority: github > gitlab > git > webpage; at most one secondary source renders.
    Reference: https://github.com/anaconda/package-build-platform/blob/main/adr/2026-05-29-channel-and-requirements-mapping-spec.md
-#}

anaconda_config_version: 1 # Required

upstream_sources:
  - pypi:
      identifier: {{ pkg_name }}
    packages: [{{ pkg_name }}]
    # enabled: true          # optional, defaults to true
    # checker: nvchecker     # optional, defaults to nvchecker
{% if github_repo | default(none) %}
  - github:
      identifier: {{ github_repo }}
    packages: [{{ pkg_name }}]
{% elif gitlab_repo | default(none) %}
  - gitlab:
      identifier: {{ gitlab_repo }}
    packages: [{{ pkg_name }}]
{% elif git_url | default(none) %}
  - git:
      identifier: {{ git_url }}
      strip_prefix: {{ git_strip_prefix | default('release-') }}
      tag_filter: {{ git_tag_filter | default('release-*') }}
    packages: [{{ pkg_name }}]
{% elif webpage_url | default(none) %}
  - webpage:
      url: {{ webpage_url }}
      regex: {{ webpage_regex }}
    packages: [{{ pkg_name }}]
{% endif %}

# https://github.com/anaconda/package-build-platform/blob/main/clients/cli/ABS_YAML.md
package_build:
  schema_version: 1
  build_config:
    - matchers:
        task: [build, test] # Options: build, test, build_wheel, test_wheel, convert_wheel
        variants: # Optional: match specific variants (e.g., python: ["3.11", "3.12"])
      dest_channels: [main]
      requirements:
        cpu_count: 1
        memory: 512mb
        failure_mode: block_on_failure # or allow_failure
        needs_admin: false
        skip_code_signing: false
        timeout: 2h
