{
  "$schema": "https://app.kilo.ai/config.json",
  "autoupdate": false,
  "formatter": false,
  "lsp": {
    "pyright": {
      "disabled": true
    }
  },
  "instructions": ["~/.config/harnesses/handoff-contract.md"],
  // Use Kilo Gateway (after signing in at app.kilo.ai)
  "provider": {
    "kilo": {
      "options": {
        "apiKey": "{env:KILO_API_KEY}"
      }
    }
  },
  "permission": {
    "bash": "ask",
    "external_directory": {
      "/tmp/kilo": "allow"
    }
  }
}
