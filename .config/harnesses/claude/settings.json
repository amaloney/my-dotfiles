{
  "awsAuthRefresh": "aws sso login --profile Sandbox-621741996708",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_PROFILE": "Sandbox-621741996708",
    "AWS_REGION": "us-east-1",
    "ANTHROPIC_MODEL": "us.anthropic.claude-opus-4-5-20251101-v1:0"
  },
  "permissions": {
    "allow": [
      "Edit(/tmp/**)",
      "Edit(/private/tmp/**)",
      "Bash(ls ~/.claude/skills/*)",
      "Bash(find ~/.claude/skills/*)",
      "Bash(scripts/crun python *)",
      "Skill(conda-project-init)"
    ],
    "deny": [
      "Read(./.coverage/**/*)",
      "Read(./.hypothesis/**/*)",
      "Read(./.ipynb_checkpoints/**/*)",
      "Read(./.pixi/**/*)",
      "Read(./.pytest_cache/**/*)",
      "Read(./.ruff_cache/**/*)",
      "Read(./htmlcov/**/*)",
      "Read(./notebooks/**/*)",
      "Read(./build)",
      "Read(./cache)",
      "Read(./data)",
      "Read(./infra)",
      "Read(./notes/**/*)",
      "Read(./.secrets/**/*)",
      "Read(./.git/**/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.mydev)",
      "Bash(env:*)",
      "Read(./credentials.txt)",
      "Read(./*.pem)",
      "Bash(pass:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/crun python $HOME/.config/harnesses/skills/chat-provenance/scripts/claude-hook.py --event user",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/crun python $HOME/.config/harnesses/skills/chat-provenance/scripts/claude-hook.py --event stop",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/crun python $HOME/.config/harnesses/scripts/style_gates.py --event stop",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/crun python $HOME/.config/harnesses/skills/chat-provenance/scripts/claude-hook.py --event subagent",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/crun python $HOME/.config/harnesses/scripts/style_gates.py --event stop",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.harness/session\" && : > \"$CLAUDE_PROJECT_DIR/.harness/session/loaded_skills.txt\" && echo '**/*' > \"$CLAUDE_PROJECT_DIR/.harness/.gitignore\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && command -v direnv >/dev/null && direnv export bash >> \"$CLAUDE_ENV_FILE\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/skills/code-index/scripts/harness-refresh.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/crun python $HOME/.config/harnesses/scripts/llm-skills-network build --skill-vectors --if-stale",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/plan-archive.sh --min-age 12h",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/plan-archive.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/check-conda-python.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "if jq -r '.tool_input.command' | grep -Eq 'conda (run|activate)'; then echo 'Use scripts/crun instead of conda run/activate' >&2; exit 2; fi",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/crun python $HOME/.config/harnesses/scripts/skill_tool_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/skills/code-index/scripts/harness-refresh.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/crun python $HOME/.config/harnesses/scripts/llm-skills-network build --skill-vectors --if-stale",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/crun python $HOME/.config/harnesses/scripts/style_gates.py --event edit",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v prettier >/dev/null && prettier --write \"$CLAUDE_FILE_PATH\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATH\" | grep -q 'SKILL.md$'; then echo \"$CLAUDE_FILE_PATH\" >> \"$CLAUDE_PROJECT_DIR/.harness/session/loaded_skills.txt\" 2>/dev/null || true; fi",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.skill // empty' | while read -r s; do [ -n \"$s\" ] && echo \"skill:$s\" >> \"$CLAUDE_PROJECT_DIR/.harness/session/loaded_skills.txt\"; done 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message.content // empty' | $HOME/.config/harnesses/scripts/check-pronouns.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true
  },
  "awaySummaryEnabled": false,
  "plansDirectory": ".harness/plans/.claude",
  "additionalDirectories": [
    "/tmp",
    "/private/tmp"
  ],
  "recap": false
}
