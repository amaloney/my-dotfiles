# Run `direnv allow` once after cloning.
#
# `cd`-ing into the project will:
#   - point conda at the project .condarc file
#   - build the default environment in ./.conda/default (if missing)
# `cd`-ing out of the project:
#   - direnv undoes everything above

export CONDARC="$PWD/.condarc"

# Reload when any env definition changes.
watch_file environment.yml conda-lock.yml .condarc

# Load conda's shell functions (conda must be on PATH).
if ! command -v conda >/dev/null 2>&1; then
    log_error "conda not found on PATH; install conda 26.5+ first"
    return 1
fi
export CONDA_AUTO_ACTIVATE_BASE=false
eval "$(conda shell.bash hook)"

# Add scripts/ to PATH
PATH_add scripts

# First run: build the dev env (prefers the lockfile).
if [ ! -d .conda/envs/dev/conda-meta ]; then
    # # Check login before trying to create env (channel access requires auth)
    # whoami_output=$(anaconda auth whoami --at anaconda.com 2>/dev/null || true)
    # if [ -z "$whoami_output" ] || echo "$whoami_output" | grep -q '"id": null'; then
    #     log_error "Not logged in. Run 'anaconda login' first, then re-enter this directory."
    #     return 1
    # fi
    log_status "creating ./.conda/envs/dev (first run, this takes a minute)"
    make env || { log_error "make env failed"; return 1; }
fi

# Activate dev as the root environment (base won't auto-activate due to CONDA_AUTO_ACTIVATE_BASE=false)
conda activate ./.conda/envs/dev

# Re-source hook from the project's conda in order to load plugins installed there.
CONDA_AUTO_ACTIVATE_BASE=false eval "$(./.conda/envs/dev/bin/conda shell.bash hook)"
