{#- Conda recipe template — schema: meta.schema.yaml (validate render context against it)
    TWO-STAGE template:
      Stage 1 (Jinja): {% raw %}...{% endraw %} blocks pass `{{ name }}`-style markers through
        literally — conda-build's own Jinja consumes them later.
      Stage 2 (string.Template.safe_substitute): `$name`, `$version`, `$sha256`, `$noarch`, `$skip`, `$build_deps`,
        `$run_deps`, `$import_name`, `$home_url`, `$license_id`, `$license_family`,
        `$license_file`, `$summary`, `$description`, `$dev_url`, `$doc_url`, `$zendesk_ticket`
-#}
{% raw %}{% set name = "$name" %}{% endraw %}
{% raw %}{% set version = "$version" %}{% endraw %}

package:
  name: {% raw %}{{ name }}{% endraw %}
  version: {% raw %}{{ version }}{% endraw %}

# --- source block: harvested from PyPI sdists, GitHub release assets, or webpage artifacts ---
source:
  url: https://pypi.io/packages/source/{% raw %}{{ name[0] }}/{{ name }}/{{ name }}-{{ version }}{% endraw %}.tar.gz
  sha256: $sha256

build:$noarch
  number: 0
  script: {% raw %}{{ PYTHON }}{% endraw %} -m pip install . -vv --no-deps --no-build-isolation$skip

# --- requirements/test blocks: harvested from conda-forge feedstocks ---
requirements:
  host:
    - python
    - pip
$build_deps
  run:
    - python
$run_deps

test:
  requires:
    - pip
  imports:
    - $import_name
  commands:
    - pip check

# --- about block: harvested from PyPI/conda/GitHub metadata aggregation ---
about:
  home: $home_url
  license: $license_id
  license_family: $license_family
  license_file: $license_file
  summary: $summary
  description: $description
  dev_url: $dev_url
  doc_url: $doc_url

extra:
  anaconda-services:
    ref:
      - https://anaconda.zendesk.com/agent/tickets/$zendesk_ticket
  recipe-maintainers:
    - anaconda-services
