# ~/.condarc
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
add_pip_as_python_dependency: true
anaconda_upload: false
always_yes: true
auto_activate_base: false
auto_update_conda: false
channels:
  - defaults
default_channels:
  - https://repo.anaconda.com/pkgs/main
changeps1: false
offline: false
report_errors: false
protect_frozen_env: true
