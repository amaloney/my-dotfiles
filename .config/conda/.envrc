# Run `direnv allow` once after cloning.
#
# `cd`-ing into the project will:
#   - point conda at the project .condarc file
#   - build the default environment in ./.conda/default (if missing)
#   - provide conda-switch function to switch environments
# `cd`-ing out of the project:
#   - direnv undoes everything above

export CONDARC="$PWD/.condarc"

# Reload when any env definition changes.
watch_file environment.yml environment-lint.yml conda-lock.yml conda-lock-lint.yml .condarc

# Load conda's shell functions (conda must be on PATH).
if ! command -v conda >/dev/null 2>&1; then
    log_error "conda not found on PATH; install conda 26.5+ first"
    return 1
fi
eval "$(conda shell.bash hook)"

# Function to switch between project environments
conda-switch() {
    local env="${1:-default}"
    local prefix=".conda/${env}"

    if [[ ! -d "${prefix}/conda-meta" ]]; then
        echo "Environment '${env}' not found. Run: make env ENV=${env}"
        return 1
    fi

    # Deactivate current if active
    [[ -n "${CONDA_PREFIX}" ]] && conda deactivate

    conda activate "${prefix}"
    echo "Activated: ${env}"
}
export -f conda-switch

# First run: build the default env (prefers the lockfile).
if [ ! -d .conda/default/conda-meta ]; then
    log_status "creating ./.conda/default (first run, this takes a minute)"
    make env || { log_error "make env failed"; return 1; }
fi

conda activate ./.conda/default
