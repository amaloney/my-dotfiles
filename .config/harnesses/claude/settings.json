{
  "awsAuthRefresh": "aws sso login --profile Sandbox-621741996708",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_PROFILE": "Sandbox-621741996708",
    "AWS_REGION": "us-east-1",
    "ANTHROPIC_MODEL": "us.anthropic.claude-opus-4-5-20251101-v1:0"
  },
  "permissions": {
    "allow": ["Edit(/tmp/**)", "Edit(/private/tmp/**)", "Bash(ls ~/.claude/skills/*)", "Bash(find ~/.claude/skills/*)"],
    "deny": [
      "Read(./.coverage/**/*)",
      "Read(./.hypothesis/**/*)",
      "Read(./.ipynb_checkpoints/**/*)",
      "Read(./.pixi/**/*)",
      "Read(./.pytest_cache/**/*)",
      "Read(./.ruff_cache/**/*)",
      "Read(./htmlcov/**/*)",
      "Read(./notebooks/**/*)",
      "Read(./build)",
      "Read(./cache)",
      "Read(./data)",
      "Read(./infra)",
      "Read(./notes/**/*)",
      "Read(./.secrets/**/*)",
      "Read(./.git/**/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.mydev)",
      "Bash(env:*)",
      "Read(./credentials.txt)",
      "Read(./*.pem)",
      "Bash(pass:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.config/harnesses/skills/chat-provenance/scripts/claude-hook.py --event user",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.config/harnesses/skills/chat-provenance/scripts/claude-hook.py --event stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.config/harnesses/skills/chat-provenance/scripts/claude-hook.py --event subagent",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/skills/code-index/scripts/harness-refresh.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 $HOME/.config/harnesses/scripts/llm-skills-network build --skill-vectors --if-stale",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/plan-archive.sh --min-age 12h",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/plan-archive.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/skills/code-index/scripts/harness-refresh.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 $HOME/.config/harnesses/scripts/llm-skills-network build --skill-vectors --if-stale",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/python-edit-gate.sh --after",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/harnesses/scripts/python-edit-gate.sh --before",
            "timeout": 10
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message.content // empty' | $HOME/.config/harnesses/scripts/check-pronouns.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true
  },
  "additionalDirectories": ["/tmp", "/private/tmp"],
  "plansDirectory": ".harness/plans/.claude",
  "recap": false,
  "awaySummaryEnabled": false
}
