# Run `direnv allow` once after cloning.
#
# `cd`-ing into the project will:
#   - point conda at the project .condarc file
#   - generate conda-lock.yaml if missing
#   - regenerate conda-lock.yaml if environment.yaml changed
#   - rebuild ./.conda/dev if conda-lock.yaml changed
#   - activate the dev environment
# `cd`-ing out of the project:
#   - direnv undoes everything above

export CONDARC="$PWD/.condarc"

# XDG Isolation Options

# OPTION A: Full XDG isolation — kilo, nvim, git, etc. all use project-local config
#
# WARNING: All XDG-compliant apps will see these overrides while in the project
#
#export XDG_CONFIG_HOME="$PWD/.config"
#export XDG_DATA_HOME="$PWD/.local/share"
#export XDG_STATE_HOME="$PWD/.local/state"
#export XDG_CACHE_HOME="$PWD/.cache"
#mkdir -p "$XDG_CONFIG_HOME/kilo" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"

# OPTION B: Selective kilo isolation — only kilo uses project-local config
#export KILO_CONFIG_DIR="$PWD/.config/kilo"
#mkdir -p "$KILO_CONFIG_DIR"

# Reload when any env definition changes.
watch_file environment.{yaml,yml} conda-lock.{yaml,yml} .condarc

# Load conda's shell functions (conda must be on PATH).
if ! command -v conda >/dev/null 2>&1; then
    log_error "conda not found on PATH; install conda 26.5+ first"
    return 1
fi
eval "$(conda shell.bash hook)"

# Staleness detection functions
detect_env_files() {
    local env_name="${1:-dev}"
    if [ "$env_name" = "dev" ]; then
        SPEC=$(ls environment.yaml environment.yml 2>/dev/null | head -1)
        LOCK=$(ls conda-lock.yaml conda-lock.yml 2>/dev/null | head -1)
        [ -z "$LOCK" ] && LOCK="conda-lock.yaml"
    else
        SPEC=$(ls "environment-${env_name}.yaml" "environment-${env_name}.yml" 2>/dev/null | head -1)
        LOCK=$(ls "conda-lock-${env_name}.yaml" "conda-lock-${env_name}.yml" 2>/dev/null | head -1)
        [ -z "$LOCK" ] && LOCK="conda-lock-${env_name}.yaml"
    fi
}

lock_is_stale() {
    [ ! -f "$LOCK" ] || [ "$SPEC" -nt "$LOCK" ]
}

env_is_stale() {
    local prefix=".conda/${1:-dev}"
    local marker="$prefix/conda-meta/history"
    [ ! -f "$marker" ] || [ "$LOCK" -nt "$marker" ]
}

# Auto-sync lock and environment
detect_env_files dev

# Prefer conda env's make; gmake on macOS, make on *nix
if [ -x .conda/dev/bin/make ]; then
    MAKE=.conda/dev/bin/make
elif [ "$(uname)" = "Darwin" ]; then
    MAKE=gmake
else
    MAKE=make
fi

if [ -n "$SPEC" ] && [ -f "$SPEC" ]; then
    if lock_is_stale; then
        if [ ! -f "$LOCK" ]; then
            log_status "generating $LOCK from $SPEC (first run)"
        else
            log_status "regenerating $LOCK ($SPEC changed)"
        fi
        $MAKE lock || { log_error "make lock failed"; return 1; }
    fi
fi

if env_is_stale dev; then
    if [ ! -d .conda/dev/conda-meta ]; then
        log_status "creating ./.conda/dev (first run, this takes a minute)"
    else
        log_status "rebuilding ./.conda/dev ($LOCK changed)"
    fi
    $MAKE env || { log_error "make env failed"; return 1; }
fi

conda activate ./.conda/dev

# Re-source hook from local conda so plugins are loaded from this env
eval "$(./.conda/dev/bin/conda shell.bash hook)"
