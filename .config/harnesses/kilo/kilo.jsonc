{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": ["~/.config/harnesses/handoff-contract.md"],
  // Use Kilo Gateway (after signing in at app.kilo.ai)
  "provider": {
    "kilo": {
      "options": {
        "apiKey": "{env:KILO_API_KEY}"
      }
    }
  },
  "permission": {
    "bash": {
      ".config/harnesses/skills/code-index/scripts/harness-refresh.sh *": "allow",
      ".config/harnesses/skills/debugging/scripts/find-polluter.sh *": "allow",
      ".config/harnesses/scripts/check-pronouns.sh *": "allow",
      "bash *": "allow",
      "chmod *": "allow",
      "cp *": "allow",
      "echo *": "allow",
      "git mv *": "allow",
      "ln *": "allow",
      "mkdir *": "allow",
      "mv *": "allow",
      "node *": "allow",
      "python3 *": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "git rm *": "allow",
      "sed *": "allow",
      "xargs *": "allow",
      "sort *": "allow",
      "read *": "allow",
      ": *": "allow",
      "pixi *": "allow",
      "tail *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "printf *": "allow",
      "find *": "allow",
      "git log *": "allow",
      "python .harness/code_index/query_temporal.py *": "allow",
      "git reset *": "allow",
      "ls *": "allow",
      "git -C *": "allow",
      "sleep *": "allow",
      "git show *": "allow",
      "stat *": "allow",
      "cat *": "allow",
      "date *": "allow",
      "git ls-files *": "allow",
      "git diff *": "allow",
      "readlink *": "allow",
      "command *": "allow",
      "diff *": "allow"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "/Users/rmaloney/Development/proserv/services/customers/in-progress/hsbc/r-h2o-feedstock/recipe/*": "allow",
      "/Users/rmaloney/Development/proserv/services/customers/in-progress/hsbc/*": "allow",
      "/Users/rmaloney/Development/proserv/services/in-progress-tools/package-build-observer/*": "allow",
      "/Users/rmaloney/Development/open-source/amaloney/package-build-observer/*": "allow",
      "/Users/rmaloney/Development/open-source/amaloney/my-dotfiles/.config/harnesses/skills/python/*": "allow",
      "/private/var/folders/nt/mhnvhmcj5s7c8191xkn1dmq80000gp/T/kilo/deslop/*": "allow",
      "/Users/rmaloney/.config/kilo/skills/code-index/*": "allow",
      "/Users/rmaloney/.claude/*": "allow",
      "/Users/rmaloney/.config/kilo/*": "allow"
    }
  }
}
