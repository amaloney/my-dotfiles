{
  // Kilo TUI settings. Copied (not linked) to ~/.config/kilo/tui.json by install.sh —
  // the TUI writes back to this file when settings change via the command palette.
  "keybinds": {
    // input_paste stays on the binary default ctrl+v (single binding per command —
    // overriding it to ctrl+p removed ctrl+v paste); palette moves to leader so
    // neither paste chord is stolen
    "command_list": "<leader>p"
  }
}
